# Kopioi tämä nimellä .env ja täytä. Älä koskaan lisää .env-tiedostoa versionhallintaan.
ANTHROPIC_API_KEY=sk-ant-...
# Malli, jolla etiketit luetaan (oletus claude-sonnet-5-5; tarkempi: claude-opus-5-5)
CLAUDE_MODEL=claude-sonnet-5-5
# Käyttökoodi, jonka sovellus kysyy puhelimessa (jätä tyhjäksi = ei koodia, ÄLÄ jätä tyhjäksi julkisella palvelimella)
APP_CODE=vaihda-tama
# Vastaanottaja
MAIL_TO=samuli.riisio@nurminenlogistics.com
MAIL_FROM=rullat@sinun-domain.fi
# Sähköposti: joko Resend...
RESEND_API_KEY=
# ...tai SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Kansio, johon kuvat ja Excelit tallennetaan (Dockerissa /data)
DATA_DIR=/data
